}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @default(now()) @map("updated_at")


  deletedAt DateTime? @map("deleted_at")
  @@map("faqs")
}

model ContactInformation {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  value     String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  deletedAt DateTime? @map("deleted_at")
  @@map("contact_information")
}

model Seo {
  id            Int      @id @default(autoincrement())
  pageSlug      String   @unique @map("page_slug")
  metaTitle     String?  @map("meta_title")
  metaDescription String? @map("meta_description")
  keywords      String?
  ogImageUrl    String?  @map("og_image_url")
  canonicalUrl  String?  @map("canonical_url")


  deletedAt DateTime? @map("deleted_at")
  @@map("seo_entries")
}

// ===================== SETTINGS MODULE =====================

model HotelSetting {
  id            Int      @id @default(autoincrement())
  hotelName     String?  @map("hotel_name")
  logoUrl       String?  @map("logo_url")
  address       String?
  phone         String?
  email         String?
  website       String?
  checkInTime   String?  @map("check_in_time")
  checkOutTime  String?  @map("check_out_time")
  taxRate       Float?   @map("tax_rate")
  currency      String?  @default("KES")
  timezone      String?  @default("Africa/Nairobi")


  deletedAt DateTime? @map("deleted_at")
  @@map("hotel_settings")
}

model PaymentSetting {
  id              Int      @id @default(autoincrement())
  method          String   @unique
  enabled         Boolean  @default(false)
  mpesaShortcode  String?  @map("mpesa_shortcode")
  mpesaConsumerKey String? @map("mpesa_consumer_key")
  mpesaConsumerSecret String? @map("mpesa_consumer_secret")
  mpesaPasskey    String?  @map("mpesa_passkey")
  tillNumber      String?  @map("till_number")
  paybillNumber   String?  @map("paybill_number")


  deletedAt DateTime? @map("deleted_at")
  @@map("payment_settings")
}

model NotificationSetting {
  id       Int     @id @default(autoincrement())
  channel  String  @unique
  enabled  Boolean @default(true)
  config   String?


  deletedAt DateTime? @map("deleted_at")
  @@map("notification_settings")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  type      String   @default("string")


  deletedAt DateTime? @map("deleted_at")
  @@map("system_settings")
}

// ===================== AUDIT MODULE =====================

model AuditLog {
