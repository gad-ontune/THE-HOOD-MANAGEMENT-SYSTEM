  userId      Int?     @map("user_id")
  module      String
  action      String
  description String?
  ipAddress   String?  @map("ip_address")
  device      String?
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  deletedAt DateTime? @map("deleted_at")
  @@map("audit_logs")
}

model UserActivity {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  activity    String
  description String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  deletedAt DateTime? @map("deleted_at")
  @@map("user_activities")
}

model SecurityEvent {
  id          Int      @id @default(autoincrement())
  eventType   String   @map("event_type")
  description String?
  ipAddress   String?  @map("ip_address")
  userId      Int?
  createdAt   DateTime @default(now()) @map("created_at")

  deletedAt DateTime? @map("deleted_at")
  @@map("security_events")
}

model FailedLogin {
  id        Int      @id @default(autoincrement())
  email     String
  ipAddress String?  @map("ip_address")
  attemptedAt DateTime @default(now()) @map("attempted_at")

  deletedAt DateTime? @map("deleted_at")
  @@map("failed_logins")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  level     String
  message   String
  context   String?
  createdAt DateTime @default(now()) @map("created_at")

  deletedAt DateTime? @map("deleted_at")
  @@map("system_logs")
}

model Partner {
